{
  "name": "fish2tank",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Real-life fish collection app - catch the encounter, keep every story.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "verify:sw": "node scripts/verify-sw-update.mjs",
    "typecheck": "tsc -b --noEmit",
    "etl": "tsx etl/run.ts",
    "warehouse": "tsx etl/build-warehouse.ts",
    "images": "tsx etl/build-images.ts",
    "marts": "tsx etl/build-marts.ts",
    "reindex": "tsx etl/rebuild-index.ts",
    "refresh": "npm run etl && npm run images && npm run portraits && npm run plates && npm run warehouse && npm run marts",
    "portraits": "tsx etl/build-portraits.ts",
    "ingest:portraits": "tsx etl/ingest-proposals.ts",
    "backfill:urls": "tsx etl/backfill-product-urls.ts",
    "care:fetch": "tsx etl/fetch-care-text.ts",
    "care:plan": "tsx etl/plan-care-batches.ts",
    "care:ingest": "tsx etl/ingest-care-proposals.ts",
    "species:review": "tsx etl/review-user-species.ts",
    "fixture:smoke": "tsx etl/build-smoke-fixture.ts",
    "contrast": "node scripts/contrast-audit.mjs",
    "shots": "node scripts/review-shots.mjs",
    "plates": "node scripts/derive-plates.mjs",
    "synonyms:propose": "tsx etl/propose-synonyms.ts",
    "genera:classify": "tsx etl/classify-genera.ts",
    "repair:holdings": "tsx etl/repair-duplicate-holdings.ts",
    "sf:fetch": "tsx etl/fetch-seriously-fish.ts",
    "sf:ingest": "tsx etl/ingest-seriously-fish.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "dexie": "^4.0.10",
    "dexie-cloud-addon": "^4.4.14",
    "dexie-react-hooks": "^1.1.7",
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@duckdb/node-api": "^1.5.5-r.4",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "aws4fetch": "^1.0.20",
    "fake-indexeddb": "^6.0.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
